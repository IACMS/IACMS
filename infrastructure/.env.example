# Copy to .env in this folder (or run: ./setup-network-env.sh)
# Used by docker-compose for LAN / network development.

# Your machine's LAN IP (first address from hostname -I). Required for Kafka clients
# on other devices; optional if you only use the API gateway from the LAN.
LAN_HOST=192.168.1.100

# Comma-separated browser origins allowed by api-gateway CORS (session cookies).
# Include both LAN and localhost so dev works either way.
CORS_ORIGIN=http://192.168.1.100:5173,http://localhost:5173

# Links in notification emails (password reset, verify email)
APP_URL=http://192.168.1.100:5173

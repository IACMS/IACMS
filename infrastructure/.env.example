# IACMS - Inter-Agency Case Management Platform
# Environment Variables Configuration
# Copy this file to infrastructure/.env and update with your actual values

# ============================================
# Application Configuration
# ============================================
NODE_ENV=development
PORT=3000
LAN_HOST=localhost

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=5434
DB_NAME=iacms
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Prisma Database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/iacms?schema=public

# ============================================
# JWT Authentication Configuration
# ============================================
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-min-32-chars-long
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=your-session-secret-min-32-chars-long

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# File Upload Configuration
# ============================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ============================================
# API Configuration
# ============================================
API_VERSION=v1
API_PREFIX=/api

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ============================================
# Web Push / VAPID Configuration
# ============================================
# Generate new keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:support@iacms.gov

# ============================================
# Internal Service Authentication
# ============================================
# Shared secret for service-to-service calls
# Generate with: openssl rand -base64 32
INTERNAL_SERVICE_TOKEN=your-internal-service-token-here

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# ============================================
# Integration Secrets Encryption (AES-256-GCM)
# ============================================
# AES-256-GCM key for encrypting Integration.apiKeyEnc / apiSecretEnc (64 hex chars = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ============================================
# OAuth2 / OIDC Engine (node-oidc-provider)
# ============================================
OIDC_ISSUER=http://localhost:3001
OIDC_DEFAULT_RESOURCE=https://api.iacms.local
# Generate with: openssl rand -base64 32
OIDC_COOKIE_SECRET=your-oidc-cookie-secret-at-least-32-chars-long
# Generate with: openssl rand -hex 32 (MUST be exactly 64 hex characters)
CLIENT_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# RSA JWKS JSON containing at least one private RS256 signing key with kid, use: sig, alg: RS256
# Generate with:
# node -e "import('jose').then(j=>j.generateKeyPair('RS256',{extractable:true})).then(k=>Promise.all([k.publicKey,k.privateKey].map(x=>import('jose').then(j=>j.exportJWK(x))))).then(([pub,priv])=>console.log(JSON.stringify({keys:[{...priv,use:'sig',alg:'RS256',kid:'iacms-1'}]})))"
OIDC_JWKS_JSON={"keys":[]}

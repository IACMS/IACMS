# Production overrides — copy to infrastructure/.env.prod and fill every value.
# Usage:
#   cd infrastructure
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d
#
# Generate secrets:
#   openssl rand -base64 32

NODE_ENV=production

# Browser / email
CORS_ORIGIN=https://your-app.example.com
APP_URL=https://your-app.example.com
LAN_HOST=your-server.example.com

# Database (host port 5434 maps to container 5432)
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:CHANGE_ME@iacms-postgres:5432/iacms?schema=public

# Redis
REDIS_PASSWORD=
REDIS_URL=redis://:CHANGE_ME@redis:6379

# Auth
JWT_SECRET=
SESSION_SECRET=

# Shared token — gateway sends this on every proxied request; all internal services verify it.
INTERNAL_SERVICE_TOKEN=

# MinIO / object storage
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Web Push / VAPID Keys (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@your-domain.gov

# Integration Secrets Encryption (AES-256-GCM, 64 hex chars = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_SECRET_KEY=

# OAuth2 / OIDC Engine
OIDC_ISSUER=https://your-iam-domain.gov
OIDC_DEFAULT_RESOURCE=https://api.iacms.local
OIDC_COOKIE_SECRET=
CLIENT_SECRET_KEY=
# RSA JWKS JSON containing at least one private RS256 signing key with kid, use: sig, alg: RS256
OIDC_JWKS_JSON={"keys":[]}

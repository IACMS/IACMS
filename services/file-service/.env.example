# File Management Service — Environment Variables
# Copy this file to .env and fill in values

# Service
PORT=3009
NODE_ENV=development
# Worker mode: 'embedded' (dev - same process) | 'standalone' (prod - separate container)
WORKER_MODE=embedded

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/iacms?schema=public

# Auth
JWT_SECRET=iacms-dev-secret-key-change-in-production
AUTH_SERVICE_URL=http://localhost:3001

# Storage — set STORAGE_PROVIDER=local for dev without MinIO
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=iacms-files
MINIO_USE_SSL=false

# Local storage fallback (used when STORAGE_PROVIDER=local)
LOCAL_STORAGE_PATH=./uploads

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=file-service

# Upload limits
MAX_UPLOAD_SIZE_MB=102400
BLOCKED_EXTENSIONS=.exe,.sh,.bat,.cmd,.ps1,.vbs,.scr,.pif,.com

# Features (all can be toggled independently)
VIRUS_SCAN_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
THUMBNAIL_ENABLED=true
THUMBNAIL_SIZES=100,250,500
COMPRESSION_IMAGE_ENABLED=true
COMPRESSION_IMAGE_FORMAT=webp
COMPRESSION_IMAGE_QUALITY=80
COMPRESSION_VIDEO_ENABLED=false

# Retention
DEFAULT_SOFT_DELETE_DAYS=30

# Chunk uploads
MAX_CHUNK_SIZE_MB=10
CHUNK_TTL_HOURS=24

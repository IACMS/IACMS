// Prisma model for IAM-owned tables.
// This is an IAM-focused schema generated from the shared IACMS database today.
// A separate database and migration history are part of the extraction roadmap.

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenant (Organization / Agency) ─────────────────────────────────────────

model Tenant {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  code               String   @unique
  description        String?  @db.Text
  config             Json?
  isActive           Boolean  @default(true) @map("is_active")
  registeredByUserId String?  @map("registered_by_user_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  registeredBy   User?           @relation("TenantRegistrar", fields: [registeredByUserId], references: [id], onDelete: SetNull)
  users          User[]
  roles          Role[]
  apiKeys        ApiKey[]
  oauthClients   OAuthClient[]
  oauthProviders OAuthProvider[]

  @@index([code])
  @@index([isActive])
  @@map("tenants")
}

// Generic IAM organization/access scope. `externalSystem` and `externalId`
// let an integrating application map its own tenant/project identifier without
// making that application's database a foreign-key dependency of IAM.
model IamOrganization {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  slug           String   @unique
  externalSystem String?  @map("external_system")
  externalId     String?  @map("external_id")
  isActive       Boolean  @default(true) @map("is_active")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  memberships IamMembership[]
  oauthClients OAuthClient[]

  @@unique([externalSystem, externalId])
  @@index([isActive])
  @@map("iam_organizations")
}

// An identity can have zero or more independent organization memberships.
// This is an access relationship; app-specific roles and domain policy stay
// with the application that owns them.
model IamMembership {
  id             String   @id @default(uuid()) @db.Uuid
  subjectId      String   @map("subject_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  status         String   @default("active")
  externalSystem String?  @map("external_system")
  externalId     String?  @map("external_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  subject      User            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  organization IamOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([subjectId, organizationId])
  @@index([organizationId, status])
  @@index([subjectId, status])
  @@map("iam_memberships")
}

// ─── User ───────────────────────────────────────────────────────────────────

model User {
  id                       String    @id @default(uuid()) @db.Uuid
  tenantId                 String?   @map("tenant_id") @db.Uuid
  email                    String
  username                 String
  passwordHash             String    @map("password_hash")
  firstName                String    @map("first_name")
  lastName                 String    @map("last_name")
  phone                    String?
  nationalId               String?   @map("national_id")
  isActive                 Boolean   @default(true) @map("is_active")
  isEmailVerified          Boolean   @default(false) @map("is_email_verified")
  mustChangePassword       Boolean   @default(false) @map("must_change_password")
  resetPasswordToken       String?   @map("reset_password_token")
  resetPasswordExpires     DateTime? @map("reset_password_expires")
  emailVerificationToken   String?   @map("email_verification_token")
  emailVerificationExpires DateTime? @map("email_verification_expires")
  lastLogin                DateTime? @map("last_login")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  tenant              Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  userRoles           UserRole[]
  userRolesAssigned   UserRole[]          @relation("RoleAssigner")
  tenantsRegistered   Tenant[]            @relation("TenantRegistrar")
  apiKeysCreated      ApiKey[]            @relation("ApiKeyCreator")
  apiKeysRevoked      ApiKey[]            @relation("ApiKeyRevoker")
  oauthConsents       OAuthConsent[]
  federatedIdentities FederatedIdentity[]
  userApplicationRoles UserApplicationRole[]
  appRolesAssigned    UserApplicationRole[] @relation("AppRoleAssigner")
  organizationMemberships IamMembership[]

  @@unique([tenantId, email])
  @@unique([tenantId, username])
  @@index([tenantId])
  @@index([email])
  @@index([username])
  @@index([resetPasswordToken])
  @@index([emailVerificationToken])
  @@map("users")
}

// ─── Role ───────────────────────────────────────────────────────────────────

model Role {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  name         String
  slug         String   @unique
  description  String?  @db.Text
  isSystemRole Boolean  @default(false) @map("is_system_role")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]
  userApplicationRoles UserApplicationRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([name])
  @@map("roles")
}

// ─── Permission ─────────────────────────────────────────────────────────────

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  resource    String
  action      String
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@map("permissions")
}

// ─── RolePermission ─────────────────────────────────────────────────────────

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ─── UserRole ───────────────────────────────────────────────────────────────

model UserRole {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  assignedBy String?   @map("assigned_by") @db.Uuid
  assignedAt DateTime  @default(now()) @map("assigned_at")
  expiresAt  DateTime? @map("expires_at")

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assigner User? @relation("RoleAssigner", fields: [assignedBy], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// ─── M2M API Keys ───────────────────────────────────────────────────────────

model ApiKey {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  oauthClientId String?   @map("oauth_client_id") @db.Uuid
  name          String
  keyPrefix     String    @map("key_prefix")
  keyHash       String    @unique @map("key_hash")
  scopes        String[]  @default([])
  isActive      Boolean   @default(true) @map("is_active")
  expiresAt     DateTime? @map("expires_at")
  lastUsedAt    DateTime? @map("last_used_at")
  lastUsedIp    String?   @map("last_used_ip")
  createdBy     String    @map("created_by") @db.Uuid
  revokedAt     DateTime? @map("revoked_at")
  revokedBy     String?   @map("revoked_by") @db.Uuid
  metadata      Json?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  oauthClient OAuthClient? @relation(fields: [oauthClientId], references: [id], onDelete: SetNull)
  creator     User         @relation("ApiKeyCreator", fields: [createdBy], references: [id])
  revoker     User?        @relation("ApiKeyRevoker", fields: [revokedBy], references: [id])

  @@index([tenantId])
  @@index([oauthClientId])
  @@index([keyHash])
  @@index([isActive, expiresAt])
  @@map("api_keys")
}

// ─── OAuth2 / OIDC Storage (node-oidc-provider) ─────────────────────────────

model OidcPayload {
  id         String    @id @db.VarChar(255)
  modelName  String    @map("model_name") @db.VarChar(64)
  payload    Json
  grantId    String?   @map("grant_id") @db.VarChar(255)
  userCode   String?   @map("user_code") @db.VarChar(255)
  uid        String?   @db.VarChar(255)
  expiresAt  DateTime? @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([grantId])
  @@index([userCode])
  @@index([uid])
  @@index([modelName, expiresAt])
  @@map("oidc_payloads")
}

model OAuthClient {
  id                      String   @id @default(uuid()) @db.Uuid
  clientId                String   @unique @map("client_id") @db.VarChar(255)
  clientSecretCiphertext  String?  @map("client_secret_ciphertext") @db.Text
  name                    String   @db.VarChar(255)
  tenantId                String?  @map("tenant_id") @db.Uuid
  iamOrganizationId       String?  @map("iam_organization_id") @db.Uuid
  redirectUris            Json     @map("redirect_uris")
  grantTypes              Json     @map("grant_types")
  responseTypes           Json     @map("response_types")
  scope                   String   @db.Text
  tokenEndpointAuthMethod String   @default("client_secret_basic") @map("token_endpoint_auth_method") @db.VarChar(64)
  targetAudience          String?  @map("target_audience") @db.VarChar(255)
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  consents OAuthConsent[]
  tenant   Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  iamOrganization IamOrganization? @relation(fields: [iamOrganizationId], references: [id], onDelete: SetNull)
  apiKeys  ApiKey[]
  userApplicationRoles UserApplicationRole[]

  @@index([tenantId])
  @@index([iamOrganizationId])
  @@index([isActive])
  @@map("oauth_clients")
}

model OAuthConsent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  scopes    String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId])
  @@index([clientId])
  @@map("oauth_consents")
}

model OAuthProvider {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String?  @map("tenant_id") @db.Uuid
  provider        String   @db.VarChar(64)
  clientId        String   @map("client_id") @db.VarChar(255)
  clientSecretEnc String   @map("client_secret_enc") @db.Text
  scopes          String[] @default([])
  isActive        Boolean  @default(true) @map("is_active")
  config          Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant              Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  federatedIdentities FederatedIdentity[]

  @@index([tenantId])
  @@index([isActive])
  @@map("oauth_providers")
}

model FederatedIdentity {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  providerId String   @map("provider_id") @db.Uuid
  externalId String   @map("external_id") @db.VarChar(255)
  email      String?  @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider OAuthProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, externalId])
  @@index([userId])
  @@map("federated_identities")
}

// Grants an IAM account a role in one registered application only.
model UserApplicationRole {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  oauthClientId String   @map("oauth_client_id") @db.Uuid
  roleId        String   @map("role_id") @db.Uuid
  assignedBy    String?  @map("assigned_by") @db.Uuid
  assignedAt    DateTime @default(now()) @map("assigned_at")
  expiresAt     DateTime? @map("expires_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthClient OAuthClient @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)
  role        Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assigner    User?       @relation("AppRoleAssigner", fields: [assignedBy], references: [id])

  @@unique([userId, oauthClientId, roleId])
  @@index([userId])
  @@index([oauthClientId])
  @@index([roleId])
  @@map("user_application_roles")
}

/// Durable publication queue for identity lifecycle events. The IACMS consumer
/// projects these records locally; credential material is never included.
model IdentityEventOutbox {
  eventId      String    @id @default(uuid()) @map("event_id") @db.Uuid
  sequence     BigInt    @unique @default(autoincrement())
  subjectId    String    @map("subject_id") @db.Uuid
  eventType    String    @map("event_type") @db.VarChar(64)
  payload      Json
  createdAt    DateTime  @default(now()) @map("created_at")
  publishedAt  DateTime? @map("published_at")
  attempts     Int       @default(0)
  lastError    String?   @map("last_error") @db.Text

  @@index([publishedAt, sequence])
  @@index([subjectId, sequence])
  @@map("identity_event_outbox")
}


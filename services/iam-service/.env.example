# IAM Service Environment Variables
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/iacms?schema=public
IAM_IDENTITY_OUTBOX_ENABLED=false
IAM_IDENTITY_EVENTS_TOPIC=iam.identity.events.v1
IAM_IDENTITY_OUTBOX_POLL_MS=2000
IAM_ORG_MEMBERSHIPS_ENABLED=false
IAM_LEGACY_ORGANIZATION_SYSTEM=iacms

# Legacy Internal JWT / Internal service auth
JWT_SECRET=your-jwt-secret-here-generate-with-openssl-rand-base64-64
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
INTERNAL_SERVICE_TOKEN=your-internal-service-token-here

# Redis
REDIS_URL=redis://localhost:6379

# ── OAuth2 / OIDC (node-oidc-provider) ──────────────────────────────────────────
# Public issuer URL (base URL of IAM service or gateway public URL)
OIDC_ISSUER=http://localhost:3001

# Optional default resource indicator. Leave empty to require clients to request `resource` explicitly.
OIDC_DEFAULT_RESOURCE=
# Scopes available to registered clients in this deployment (space or comma separated).
OIDC_SUPPORTED_SCOPES=openid offline_access profile email roles api_key
# Scopes accepted for resource-indicator access tokens in this deployment.
OIDC_RESOURCE_SCOPES=openid profile email roles api_key

# Enable only after IAM is pointed at its isolated database and the IAM
# tenantless-identity migration has been deployed there. This is disabled in
# the shared IACMS database because legacy services require User.tenantId.
IAM_GLOBAL_IDENTITIES_ENABLED=false

# Cookie signing secret for interaction sessions (min 32 bytes)
# Generate with: openssl rand -base64 32
OIDC_COOKIE_SECRET=your-oidc-cookie-secret-at-least-32-chars-long

# AES-256-GCM encryption key for OAuth client secrets and social provider secrets
# MUST be exactly 64 hex characters (32 bytes)
# Generate with: openssl rand -hex 32
CLIENT_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# RSA JWKS JSON containing at least one private RS256 signing key with 'kid', 'use': 'sig', 'alg': 'RS256'
# Generate with:
# node -e "import('jose').then(j=>j.generateKeyPair('RS256',{extractable:true})).then(k=>Promise.all([k.publicKey,k.privateKey].map(x=>import('jose').then(j=>j.exportJWK(x))))).then(([pub,priv])=>console.log(JSON.stringify({keys:[{...priv,use:'sig',alg:'RS256',kid:'iacms-1'}]})))"
OIDC_JWKS_JSON={"keys":[]}

# ── Social Identity Providers (Optional / Phase 4) ────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=


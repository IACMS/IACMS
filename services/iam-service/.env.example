# IAM Service Environment Variables
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/iacms?schema=public

# Legacy Internal JWT / Internal service auth
JWT_SECRET=your-jwt-secret-here-generate-with-openssl-rand-base64-64
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
INTERNAL_SERVICE_TOKEN=your-internal-service-token-here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── OAuth2 / OIDC (node-oidc-provider) ──────────────────────────────────────────
# Public issuer URL (base URL of IAM service or gateway public URL)
OIDC_ISSUER=http://localhost:3001

# Default resource indicator audience for access tokens
OIDC_DEFAULT_RESOURCE=https://api.iacms.local

# Cookie signing secret for interaction sessions (min 32 bytes)
# Generate with: openssl rand -base64 32
OIDC_COOKIE_SECRET=your-oidc-cookie-secret-at-least-32-chars-long

# AES-256-GCM encryption key for OAuth client secrets and social provider secrets
# MUST be exactly 64 hex characters (32 bytes)
# Generate with: openssl rand -hex 32
CLIENT_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# RSA JWKS JSON containing at least one private RS256 signing key with 'kid', 'use': 'sig', 'alg': 'RS256'
# Generate with:
# node -e "import('jose').then(j=>j.generateKeyPair('RS256',{extractable:true})).then(k=>Promise.all([k.publicKey,k.privateKey].map(x=>import('jose').then(j=>j.exportJWK(x))))).then(([pub,priv])=>console.log(JSON.stringify({keys:[{...priv,use:'sig',alg:'RS256',kid:'iacms-1'}]})))"
OIDC_JWKS_JSON={"keys":[]}

# ── Social Identity Providers (Optional / Phase 4) ────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

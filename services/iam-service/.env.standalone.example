# Copy to .env.standalone and replace every placeholder before deployment.
NODE_ENV=production
IAM_PORT=3001

# These must use the same IAM_POSTGRES_PASSWORD. Keep this database isolated
# from IACMS and use a dedicated runtime role for production deployments.
IAM_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
IAM_DATABASE_URL=postgresql://iam:REPLACE_WITH_RANDOM_DATABASE_PASSWORD@iam-postgres:5432/iam?schema=public
IAM_MIGRATION_DATABASE_URL=postgresql://iam:REPLACE_WITH_RANDOM_DATABASE_PASSWORD@iam-postgres:5432/iam?schema=public

# Generate independent values with: openssl rand -base64 48
IAM_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
IAM_INTERNAL_SERVICE_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
OIDC_COOKIE_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CLIENT_SECRET_KEY=REPLACE_WITH_64_HEX_CHARACTERS_FROM_openssl_rand_-hex_32

# Generate an RS256 private signing JWK and keep it in a deployment secret
# store. OIDC_ISSUER must be the public HTTPS URL clients will use.
OIDC_ISSUER=https://iam.example.com
IAM_ADMIN_AUDIENCE=https://iam.example.com/admin-api
OIDC_JWKS_JSON=REPLACE_WITH_PRIVATE_RS256_JWKS_JSON

IAM_GLOBAL_IDENTITIES_ENABLED=true
IAM_ORG_MEMBERSHIPS_ENABLED=true
# Use `iacms` only for a deployment maintaining the legacy IACMS tenant bridge.
IAM_LEGACY_ORGANIZATION_SYSTEM=none
IAM_API_KEY_PREFIX=iam_live_
IAM_API_KEY_SCOPES=api:read,api:write
OIDC_ACCESS_TOKEN_TTL_SECONDS=600
OIDC_SUPPORTED_SCOPES=openid offline_access profile email roles api_key iam:admin
OIDC_RESOURCE_SCOPES=openid profile email roles api_key iam:admin

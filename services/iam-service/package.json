{
  "name": "iam-service",
  "version": "1.0.0",
  "description": "IACMS Identity and Access Management Service - Auth & RBAC",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run tests/unit tests/regression",
    "test:integration": "vitest run tests/integration",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate --schema=../../prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "prisma": "^6.0.0"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "vitest": "^3.0.0"
  }
}

{
  "name": "iam-service",
  "version": "1.0.0",
  "description": "Central IAM and OAuth/OIDC identity provider (IACMS extraction in progress)",
  "main": "src/server.js",
  "type": "module",
  "imports": {
    "#iam/*": "./src/*"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run tests/unit tests/regression",
    "test:integration": "vitest run tests/integration",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "prisma:migrate:status": "prisma migrate status --schema=./prisma/schema.prisma",
    "seed:admin-client": "node scripts/seed-admin-portal-client.js",
    "db:setup": "prisma generate --schema=./prisma/schema.prisma && prisma migrate deploy --schema=./prisma/schema.prisma && node scripts/seed-admin-portal-client.js",
    "data:backfill-memberships": "node scripts/backfill-legacy-iam-memberships.js"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.10.0",
    "jose": "^6.2.14",
    "kafkajs": "^2.2.4",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "oidc-provider": "^9.13.3",
    "openid-client": "^6.8.8",
    "prisma": "^6.0.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "vitest": "^3.0.0"
  }
}

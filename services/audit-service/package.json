{
  "name": "audit-service",
  "version": "1.0.0",
  "description": "IACMS Audit Service",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run tests/unit tests/regression",
    "test:integration": "vitest run tests/integration",
    "test:all": "vitest run",
    "migrate": "prisma migrate dev --schema=../../prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema=../../prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema=../../prisma/schema.prisma"
  },
  "dependencies": {
    "express": "^5.2.1",
    "@prisma/client": "^6.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.2.3",
    "prisma": "^6.0.0"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "vitest": "^3.0.0"
  }
}

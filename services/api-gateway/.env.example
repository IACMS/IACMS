# API Gateway
PORT=3000

# Session cookies + Redis session store (connect-redis). Required for /api/v1/session/*.
REDIS_URL=redis://localhost:6379
SESSION_SECRET=change-me
SESSION_MAX_AGE=86400

# Must match iam-service JWT signing secret for gateway to verify Bearer tokens.
JWT_SECRET=change-me

# Shared with all internal microservices — gateway sends this on proxied requests.
# Required in production. Generate with: openssl rand -base64 32
# INTERNAL_SERVICE_TOKEN=

# CORS (comma-separated). For LAN dev, include your machine IP, e.g.:
# CORS_ORIGIN=http://192.168.1.42:5173,http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Downstream services (consolidated architecture)
IAM_SERVICE_URL=http://localhost:3001
AUTH_SERVICE_URL=http://localhost:3001
RBAC_SERVICE_URL=http://localhost:3001
CASE_ENGINE_SERVICE_URL=http://localhost:3003
CASE_SERVICE_URL=http://localhost:3003
WORKFLOW_SERVICE_URL=http://localhost:3003
REFERRAL_SERVICE_URL=http://localhost:3003
AUDIT_SERVICE_URL=http://localhost:3006
INTEGRATION_SERVICE_URL=http://localhost:3007
NOTIFICATION_SERVICE_URL=http://localhost:3008
FILE_SERVICE_URL=http://localhost:3009

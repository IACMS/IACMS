{
  "name": "workflow-service",
  "version": "1.0.0",
  "description": "IACMS Workflow Service",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",

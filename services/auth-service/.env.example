# Copy to .env. All IACMS services use the same Postgres database name: iacms
# (see infrastructure/docker-compose.yml POSTGRES_DB). Port 5433 = host map for local Docker.

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/iacms?schema=public

PORT=3001
JWT_SECRET=change-this-secret-key
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
KAFKA_BROKERS=localhost:9092
REDIS_URL=redis://localhost:6379

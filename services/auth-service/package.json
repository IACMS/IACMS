{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "IACMS Authentication Service - Handles user authentication and JWT tokens",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:all": "vitest run",
    "test:watch": "vitest tests/unit",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.0",
    "supertest": "^7.0.0",
    "vitest": "^3.0.0"
  }
}

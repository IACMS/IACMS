# ============================================
# Notification Service Environment Variables
# ============================================
PORT=3008
NODE_ENV=development

# Kafka Broker Configuration
KAFKA_BROKERS=localhost:9092

# Redis Cache (Pub/Sub & notifications)
REDIS_URL=redis://localhost:6379

# Shared secret for internal service-to-service communication
# Generate with: openssl rand -base64 32
INTERNAL_SERVICE_TOKEN=your-internal-service-token-here

# Web Push / VAPID Keys
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:support@iacms.gov

# SMTP Email Configuration (e.g. Mailtrap in dev, Sendgrid/SES in prod)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="IACMS Platform <noreply@iacms.gov>"

# Application URL used in email reset links
APP_URL=http://localhost:5173

# OAuth2 / OIDC Audience for offline JWT verification
SERVICE_AUDIENCE=https://notifications.iacms.gov/api


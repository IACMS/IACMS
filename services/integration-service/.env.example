# ============================================
# Integration Service Environment Variables
# ============================================
PORT=3007
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/iacms?schema=public

# Kafka Broker Configuration
KAFKA_BROKERS=localhost:9092

# Shared secret for internal service-to-service communication
# Generate with: openssl rand -base64 32
INTERNAL_SERVICE_TOKEN=your-internal-service-token-here

# AES-256-GCM key for encrypting Integration.apiKeyEnc / apiSecretEnc (64 hex chars = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef


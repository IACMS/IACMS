# ============================================
# Case Engine Service Environment Variables
# ============================================
PORT=3003
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/iacms?schema=public

# Kafka Broker Configuration
KAFKA_BROKERS=localhost:9092

# Redis Cache (Optional for workflow state caching)
REDIS_URL=redis://localhost:6379

# Shared secret for internal service-to-service communication
# Generate with: openssl rand -base64 32
INTERNAL_SERVICE_TOKEN=your-internal-service-token-here

# OAuth2 / OIDC Audience for offline JWT verification
SERVICE_AUDIENCE=https://cases.iacms.gov/api

# RSA JWKS JSON containing public keys for offline JWT token verification
OIDC_JWKS_JSON={"keys":[]}


PORT=3010
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/iacms?schema=public"
REDIS_URL="redis://localhost:6379"
KAFKA_BROKERS="localhost:9092"
JWT_SECRET="change-this-secret-key"
INTERNAL_SERVICE_TOKEN="development-internal-token"

# Outbox worker tuning
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50

# Cleanup interval (ms) — how often to purge old published outbox events
CLEANUP_INTERVAL_MS=21600000

# Internal URLs
FILE_SERVICE_URL="http://localhost:3009"
IAM_SERVICE_URL="http://localhost:3001"
NOTIFICATION_SERVICE_URL="http://localhost:3008"
